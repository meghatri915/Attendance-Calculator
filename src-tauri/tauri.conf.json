{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "attendance-calculator",
  "version": "0.1.0",
  "identifier": "com.attendancecalculator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Attendance Calculator",
        "width": 480,
        "height": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
